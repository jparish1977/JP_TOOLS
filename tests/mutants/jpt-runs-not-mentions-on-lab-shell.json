{
 "about": "jpcheck/lab_shell.py's module-level tables, which mutmut does not mutate (its functions are mutmut's): control words, wrappers and their value options, option marks, find's exec forms, the escape width and how parentheses nest. Run: mutate-on-target.py TREE jpcheck/lab_shell.py tests/test_lab_not_executed.py tests/mutants/jpt-runs-not-mentions-on-lab-shell.json",
 "mutants": [
  {"name": "control-words-not-skipped", "edits": [["_CONTROL = {\"if\", \"then\", \"elif\", \"else\", \"while\", \"until\", \"do\", \"!\", \"{\"}", "_CONTROL: set[str] = set()"]], "target": "sh: if"},
  {"name": "sudo-u-takes-no-value", "edits": [["    \"sudo\": {\"-u\", \"--user\",", "    \"sudo\": {\"--user\","]], "target": "sh: sudo -u"},
  {"name": "plus-is-no-option", "edits": [["_OPTION_MARKS = (\"-\", \"+\")", "_OPTION_MARKS = (\"-\",)"]], "target": "sh: bash +o"},
  {"name": "find-exec-unknown", "edits": [["_FIND_EXEC = {\"-exec\", \"-execdir\", \"-ok\", \"-okdir\"}", "_FIND_EXEC = {\"-execdir\", \"-ok\", \"-okdir\"}"]], "target": "sh: find -exec"},
  {"name": "escape-is-one-character", "edits": [["_ESCAPED = 2", "_ESCAPED = 1"]], "target": "sh: an unpaired escaped backtick"},
  {"name": "parentheses-do-not-nest", "edits": [["_DEPTH = {\"(\": 1, \")\": -1}", "_DEPTH = {\")\": -1}"]], "target": "sh: nested parentheses inside $()"}
 ]
