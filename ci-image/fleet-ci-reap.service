# Runs ci-image/reap.sh from iteration8's JP_TOOLS checkout. Installed as a
# user unit with ci-image/fleet-ci-reap.timer:
#   systemctl --user link ~/projects/JP_TOOLS/ci-image/fleet-ci-reap.service
#   systemctl --user enable --now ~/projects/JP_TOOLS/ci-image/fleet-ci-reap.timer
[Unit]
Description=Remove dead CI job containers, their volumes and unused images from the runner's dind

[Service]
Type=oneshot
ExecStart=/bin/bash %h/projects/JP_TOOLS/ci-image/reap.sh
