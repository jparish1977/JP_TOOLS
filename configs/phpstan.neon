parameters:
    # JP_TOOLS shared PHPStan config.
    # Level 8, because METHODOLOGY section 2.5 says level 8. A gate quieter
    # than the manual shipped beside it is worse than either setting on its
    # own: on one PHP codebase level 5 reported 3 findings and level 8
    # reported 17, so most of the verdict was missing while the summary read
    # as authoritative.
    level: 8

    # Don't fail on missing vendor stubs for common frameworks.
    # Add project-specific ignores in a local phpstan.neon that includes this one.
    ignoreErrors: []

    # Treat all files as potential entry points (no bootstrapping required)
    reportUnmatchedIgnoredErrors: false
