{
    "name": "jp-tools/php-quality",
    "description": "PHP code quality tools for JP_TOOLS",
    "require-dev": {
        "iteration8/core": "dev-master",
        "iteration8/utilities": "dev-master",
        "nikic/php-parser": "5.8.0",
        "phpstan/phpstan": "2.2.8",
        "phpunit/phpunit": "12.5.33",
        "rector/rector": "2.6.2",
        "squizlabs/php_codesniffer": "3.13.6"
    },
    "autoload": {
        "psr-4": {
            "JpTools\\": "lib/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "extra": {
        "jp-tools-gate": [
            "nikic/php-parser",
            "phpstan/phpstan",
            "rector/rector",
            "squizlabs/php_codesniffer"
        ]
    }
}
