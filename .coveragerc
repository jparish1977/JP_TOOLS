# Coverage config for JP_TOOLS. docs/coverage.md explains each choice.
#
# branch: a statement-only number counts an `if` as covered when only one side
# ever ran, and one-sided branches are where bugs live.
#
# parallel: suites that drive a tool as a SUBPROCESS are not traced without
# this plus COVERAGE_PROCESS_START and the .pth CI installs; untraced, tested
# code reads as a gap, and the obvious fix for a gap is a pragma.
[run]
branch = True
parallel = True

[report]
# Deliberately empty of the default `pragma: no cover` rule: honouring it
# would hide exactly the region most likely to hold an untested decision. The
# pragma is a documented claim, policed by check.py's `no-cover` check and
# read with list-exemptions.py, and coverage measures the code regardless.
# `(?!)` is a lookahead that can never match: "exclude nothing".
exclude_lines =
    (?!)
show_missing = True
skip_covered = False
